<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="5.0" minGap="2.5" maxSpeed="13"/>
    
    <!-- Routes definition -->
    <route id="r_S2W" edges="S2C C2W"/>
    <route id="r_S2E" edges="S2C C2E"/>
    <route id="r_S2N" edges="S2C C2N"/>
    
    <route id="r_W2N" edges="W2C C2N"/>
    <route id="r_W2S" edges="W2C C2S"/>
    <route id="r_W2E" edges="W2C C2E"/>
    
    <route id="r_E2S" edges="E2C C2S"/>
    <route id="r_E2N" edges="E2C C2N"/>
    <route id="r_E2W" edges="E2C C2W"/>
    
    <route id="r_N2E" edges="N2C C2E"/>
    <route id="r_N2W" edges="N2C C2W"/>
    <route id="r_N2S" edges="N2C C2S"/>

    <!-- Flows: Probability 0.05 per second (~1 car every 20s per direction) -->
    <flow id="f_S2W" type="car" route="r_S2W" begin="0" end="3600" probability="0.05"/>
    <flow id="f_S2E" type="car" route="r_S2E" begin="0" end="3600" probability="0.05"/>
    <flow id="f_S2N" type="car" route="r_S2N" begin="0" end="3600" probability="0.05"/>
    
    <flow id="f_W2N" type="car" route="r_W2N" begin="0" end="3600" probability="0.05"/>
    <flow id="f_W2S" type="car" route="r_W2S" begin="0" end="3600" probability="0.05"/>
    <flow id="f_W2E" type="car" route="r_W2E" begin="0" end="3600" probability="0.05"/>
    
    <flow id="f_E2S" type="car" route="r_E2S" begin="0" end="3600" probability="0.05"/>
    <flow id="f_E2N" type="car" route="r_E2N" begin="0" end="3600" probability="0.05"/>
    <flow id="f_E2W" type="car" route="r_E2W" begin="0" end="3600" probability="0.05"/>
    
    <flow id="f_N2E" type="car" route="r_N2E" begin="0" end="3600" probability="0.05"/>
    <flow id="f_N2W" type="car" route="r_N2W" begin="0" end="3600" probability="0.05"/>
    <flow id="f_N2S" type="car" route="r_N2S" begin="0" end="3600" probability="0.05"/>
</routes>
